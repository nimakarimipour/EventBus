        // Also we might avoid some ClassNotFoundException (see FAQ for background).
        if (clazzName.startsWith("java.")
            || clazzName.startsWith("javax.")
            || clazzName.startsWith("android.")
            || clazzName.startsWith("androidx.")) {
          clazz = null;
        }
      }
}
